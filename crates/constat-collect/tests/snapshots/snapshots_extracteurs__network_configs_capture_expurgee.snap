### constat:fichier netdev:fw-dmz-01
#config-version=FGT60F-7.0.5-FW-build0304-220328:opmode=0:vdom=0
# Configuration fictive et anonyme - fixture de test constat.
# Adressage RFC1918 invente ; secrets FACTICES pour exercer l'expurgation.
config system global
    set hostname "fw-dmz-01"
end
config system admin
    edit "admin"
        set password [EXPURGÉ:mot-de-passe]
        set accprofile "super_admin"
    next
end
config system interface
    edit "lan"
        set vdom "root"
        set ip 10.10.1.1 255.255.255.0
        set allowaccess ping https ssh
        set type physical
        set role lan
    next
    edit "dmz"
        set vdom "root"
        set ip 10.10.2.1 255.255.255.0
        set allowaccess ping
        set type physical
        set role dmz
    next
    edit "wan"
        set vdom "root"
        set ip 10.200.0.2 255.255.255.252
        set type physical
        set role wan
    next
end
config vpn ipsec phase1-interface
    edit "vpn-agence"
        set interface "wan"
        set peertype any
        set proposal aes256-sha256
        set remote-gw 10.201.0.9
        set psksecret [EXPURGÉ:cle-partagee]
    next
end
config firewall address
    edit "h-srv-web"
        set subnet 10.10.2.10 255.255.255.255
    next
end
config firewall policy
    edit 1
        set name "lan-vers-dmz-web"
        set srcintf "lan"
        set dstintf "dmz"
        set srcaddr "all"
        set dstaddr "h-srv-web"
        set action accept
        set schedule "always"
        set service "HTTPS"
    next
    edit 2
        set name "dmz-isolement"
        set srcintf "dmz"
        set dstintf "lan"
        set srcaddr "all"
        set dstaddr "all"
        set action deny
        set schedule "always"
        set service "ALL"
    next
end
