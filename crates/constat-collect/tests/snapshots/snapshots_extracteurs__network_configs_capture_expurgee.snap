### constat:fichier netdev:pass-usine-04
#!/usr/sbin/nft -f
# Configuration fictive et anonyme - fixture de test constat.
# Adressage RFC1918 invente ; aucun equipement ni nom reel.

flush ruleset

define net_admin = 10.20.30.0/24

table inet filtre {
    set postes_surv {
        type ipv4_addr
        flags interval
        elements = { 10.20.40.0/26, 10.20.41.16/28 }
    }

    chain entree {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop

        iifname "lo" accept
        ip saddr $net_admin tcp dport { 22, 443 } accept
        ip saddr @postes_surv udp dport 161 accept
        ip protocol icmp accept
    }

    chain transit {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ip saddr 192.168.99.0/24 drop
        iifname "lan0" oifname "wan0" jump sortie_lan
    }

    chain sortie_lan {
        tcp dport { 80, 443 } accept
        udp dport 53 accept
    }
}
### constat:fichier netdev:rtr-agence-02
!
! Configuration fictive et anonyme - fixture de test constat.
! Adressage RFC1918 invente ; secrets FACTICES pour exercer l'expurgation.
!
version 15.4
service timestamps log datetime msec
service password-encryption
!
hostname rtr-agence-02
!
enable secret 5 [EXPURGÉ:hachage]
!
username ops secret 5 [EXPURGÉ:hachage]
username invite password 0 [EXPURGÉ:mot-de-passe]
!
interface GigabitEthernet0/0
 description LAN utilisateurs
 ip address 10.20.1.1 255.255.255.0
 ip access-group ACL-ENTREE-LAN in
 no shutdown
!
interface GigabitEthernet0/1
 description segment serveurs
 ip address 10.20.2.1 255.255.255.0
 standby 1 ip 10.20.2.254
 standby 1 authentication md5 key-string [EXPURGÉ:cle-partagee]
!
interface GigabitEthernet0/2
 description liaison WAN operateur
 ip address 10.200.1.2 255.255.255.252
!
ip route 0.0.0.0 0.0.0.0 10.200.1.1
!
ip access-list extended ACL-ENTREE-LAN
 permit tcp 10.20.1.0 0.0.0.255 host 10.20.2.10 eq 445
 permit udp any host 10.20.2.53 eq domain
 deny ip any any log
!
key chain SECOURS
 key 1
  key-string [EXPURGÉ:cle-partagee]
!
crypto isakmp key [EXPURGÉ:cle-partagee] address 10.200.1.9
!
tacacs-server host 10.20.2.40 key 7 [EXPURGÉ:cle-partagee]
radius-server host 10.20.2.41 auth-port 1812 key [EXPURGÉ:cle-partagee]
!
snmp-server community [EXPURGÉ:communauté-snmp] RO
logging host 10.20.2.20
ntp server 10.20.2.30
!
line vty 0 4
 transport input ssh
!
end
