#!/usr/sbin/nft -f
# Configuration fictive et anonyme - fixture de test constat.
# Adressage RFC1918 invente ; aucun equipement ni nom reel.

flush ruleset

define net_admin = 10.20.30.0/24

table inet filtre {
    set postes_surv {
        type ipv4_addr
        flags interval
        elements = { 10.20.40.0/26, 10.20.41.16/28 }
    }

    chain entree {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop

        iifname "lo" accept
        ip saddr $net_admin tcp dport { 22, 443 } accept
        ip saddr @postes_surv udp dport 161 accept
        ip protocol icmp accept
    }

    chain transit {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ip saddr 192.168.99.0/24 drop
        iifname "lan0" oifname "wan0" jump sortie_lan
    }

    chain sortie_lan {
        tcp dport { 80, 443 } accept
        udp dport 53 accept
    }
}
