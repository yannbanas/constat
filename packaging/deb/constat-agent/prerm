#!/bin/sh
# prerm du paquet constat-agent : arrêt propre de la collecte planifiée.
set -e

case "$1" in
    remove)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl disable --now constat-agent.timer >/dev/null 2>&1 || true
            systemctl stop constat-agent.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
