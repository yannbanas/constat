# Options locales de l'agent Constat (fichier de configuration, conservé
# par les mises à jour de paquet).
#
# CONSTAT_AGENT_OPTS est ajouté tel quel à `constat-agent run --once` par
# l'unité systemd. Exemple, pour pousser vers le serveur central après
# chaque collecte :
#
# CONSTAT_AGENT_OPTS=--push --server https://constat.interne:8443 --cert /etc/constat/agent.pem --key /etc/constat/agent.key.pem --ca /etc/constat/ca.pem
#
CONSTAT_AGENT_OPTS=
